{
  "manifest_version": 3,
  "name": "PhantomPrint",
  "short_name": "PhantomPrint",
  "version": "3.1.0",
  "description": "Complete anti-detect browser extension: fingerprint spoofing, cookie management, tracker blocking, proxy, mobile emulation, cloud sync, and more. Rivals Multilogin & GoLogin.",
  "homepage_url": "https://github.com/phantomprint/phantomprint",
  "browser_specific_settings": {
    "gecko": {
      "id": "phantomprint@privacy.tools",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "scripting",
    "webNavigation",
    "alarms",
    "notifications",
    "cookies",
    "privacy"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background/service-worker.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject/main-world-inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "header_rules",
        "enabled": true,
        "path": "rules/header-rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "test/fingerprint-test.html",
        "onboarding/onboarding.html",
        "data/user-agents-data.json",
        "data/statcounter-data.json",
        "data/caniuse-data.json",
        "data/webgl-profiles.json",
        "data/amiunique-distributions.json",
        "data/ua-categories.json",
        "data/tls-fingerprints.json",
        "data/profiles/windows.json",
        "data/profiles/macos.json",
        "data/profiles/android.json",
        "data/profiles/ios.json",
        "data/profiles/linux.json",
        "data/font-database.json",
        "data/gpu-database.json",
        "data/timezone-database.json",
        "data/modules/ua-database.js",
        "data/modules/market-share.js",
        "data/modules/feature-support.js",
        "data/modules/webgl-database.js",
        "data/modules/distribution-data.js",
        "data/modules/ua-categories.js",
        "data/modules/fingerprint-validator.js",
        "data/modules/harvest-collector.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
